#!/usr/bin/env python3
"""Orbbec color vision gate — idle until a mission camera block activates it."""

from __future__ import annotations

import json
import threading
import time
from typing import Dict, List, Optional, Tuple

import cv2
import numpy as np
import rclpy
from cv_bridge import CvBridge
from rclpy.callback_groups import ReentrantCallbackGroup
from rclpy.executors import MultiThreadedExecutor
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import CompressedImage, Image
from std_msgs.msg import String
from std_srvs.srv import SetBool

from skill23_vision.srv import FindColor, SetGate


COLOR_HSV: Dict[str, List[Tuple[Tuple[int, int, int], Tuple[int, int, int]]]] = {
    'red': [
        ((0, 80, 60), (10, 255, 255)),
        ((160, 80, 60), (179, 255, 255)),
    ],
    'orange': [((10, 80, 60), (25, 255, 255))],
    'yellow': [((25, 80, 60), (35, 255, 255))],
    'green': [((35, 60, 40), (85, 255, 255))],
    'blue': [((90, 60, 40), (130, 255, 255))],
    'purple': [((130, 50, 40), (160, 255, 255))],
    'white': [((0, 0, 180), (179, 40, 255))],
    'black': [((0, 0, 0), (179, 255, 50))],
}


class VisionGateNode(Node):
    """
    CPU-saving design:
      - IDLE: no camera subscription → no OpenCV
      - ACTIVE: subscribe, detect colors, optional JPEG preview for dashboard
    """

    def __init__(self):
        super().__init__('adev_vision_gate')
        self.declare_parameter('color_topic', '/camera/color/image_raw')
        self.declare_parameter('min_pixel_ratio', 0.008)
        self.declare_parameter('preview_jpeg_quality', 50)
        self.declare_parameter('publish_preview', True)

        self._color_topic = self.get_parameter('color_topic').value
        self._min_ratio = float(self.get_parameter('min_pixel_ratio').value)
        self._jpeg_quality = int(self.get_parameter('preview_jpeg_quality').value)
        self._publish_preview = bool(self.get_parameter('publish_preview').value)

        self._bridge = CvBridge()
        self._active = False
        self._lock = threading.Lock()
        self._latest_bgr: Optional[np.ndarray] = None
        self._latest_stamp = 0.0
        self._image_sub = None
        self._stream_enabled: Optional[bool] = None
        self._idle_request_in_flight = False

        self._status_pub = self.create_publisher(String, '/adev/vision/status', 10)
        self._preview_pub = self.create_publisher(
            CompressedImage, '/adev/vision/preview/compressed', 1)

        srv_group = ReentrantCallbackGroup()
        self._camera_toggle_cli = self.create_client(
            SetBool, '/camera/toggle_color', callback_group=srv_group)
        self.create_service(
            SetGate, '/adev/vision/set_gate', self._on_set_gate,
            callback_group=srv_group)
        self.create_service(
            FindColor, '/adev/vision/find_color', self._on_find_color,
            callback_group=srv_group)

        self.create_timer(1.0, self._publish_status)
        # enable_color:=true is needed for the Orbbec toggle service to exist.
        # As soon as the driver is ready, stop its hardware color stream.
        self._idle_timer = self.create_timer(0.5, self._ensure_initial_idle)
        self.get_logger().info(
            'Vision gate IDLE — waiting to stop Orbbec color stream. '
            'Activate via /adev/vision/set_gate or find_color.')

    def _ensure_initial_idle(self):
        if self._active or self._idle_request_in_flight:
            return
        if not self._camera_toggle_cli.service_is_ready():
            return
        self._idle_request_in_flight = True
        request = SetBool.Request()
        request.data = False
        future = self._camera_toggle_cli.call_async(request)
        future.add_done_callback(self._on_initial_idle_done)

    def _on_initial_idle_done(self, future):
        self._idle_request_in_flight = False
        try:
            response = future.result()
            if not response.success:
                self.get_logger().warn(
                    f'Orbbec refused initial color stop: {response.message}')
                return
            if not self._active:
                self._stream_enabled = False
            self._idle_timer.cancel()
            self.get_logger().info(
                'Orbbec color hardware stream STOPPED — zero frame processing while idle')
        except Exception as exc:
            self.get_logger().warn(f'Initial Orbbec color stop failed: {exc}')

    def _set_camera_stream(self, enabled: bool, timeout_sec: float = 3.0) -> bool:
        """Start/stop the Orbbec hardware color stream without restarting its node."""
        if self._stream_enabled is enabled:
            return True
        if not self._camera_toggle_cli.wait_for_service(timeout_sec=timeout_sec):
            self.get_logger().error(
                '/camera/toggle_color unavailable; cannot change hardware stream')
            return False

        request = SetBool.Request()
        request.data = bool(enabled)
        future = self._camera_toggle_cli.call_async(request)
        deadline = time.time() + timeout_sec
        while rclpy.ok() and not future.done() and time.time() < deadline:
            time.sleep(0.02)
        if not future.done():
            self.get_logger().error(
                f'Orbbec color {"start" if enabled else "stop"} timed out')
            return False
        try:
            response = future.result()
            if not response.success:
                self.get_logger().error(
                    f'Orbbec color toggle failed: {response.message}')
                return False
            self._stream_enabled = enabled
            self.get_logger().info(
                f'Orbbec color hardware stream {"STARTED" if enabled else "STOPPED"}')
            return True
        except Exception as exc:
            self.get_logger().error(f'Orbbec color toggle error: {exc}')
            return False

    def _on_set_gate(self, request, response):
        if request.data:
            response.success = self._activate()
            response.message = (
                'ACTIVE — hardware stream started'
                if response.success
                else 'FAILED — could not start Orbbec color stream')
        else:
            response.success = self._deactivate()
            response.message = (
                'IDLE — hardware stream stopped'
                if response.success
                else 'WARNING — subscription stopped, hardware stop unconfirmed')
        return response

    def _activate(self):
        if self._active:
            return True
        # Start the physical sensor stream before subscribing to frames.
        if not self._set_camera_stream(True):
            return False
        self._idle_timer.cancel()
        with self._lock:
            if self._active:
                return True
            self._active = True
            self._image_sub = self.create_subscription(
                Image, self._color_topic, self._on_image,
                qos_profile_sensor_data)
        self.get_logger().info(f'Vision ACTIVE on {self._color_topic}')
        return True

    def _deactivate(self):
        with self._lock:
            self._active = False
            if self._image_sub is not None:
                self.destroy_subscription(self._image_sub)
                self._image_sub = None
            self._latest_bgr = None
        # Stop capture/USB frame production as well as our OpenCV subscription.
        stopped = self._set_camera_stream(False)
        self.get_logger().info(
            'Vision IDLE (unsubscribed; hardware stream '
            f'{"stopped" if stopped else "stop unconfirmed"})')
        return stopped

    def _on_image(self, msg: Image):
        if not self._active:
            return
        try:
            bgr = self._bridge.imgmsg_to_cv2(msg, desired_encoding='bgr8')
        except Exception as exc:
            self.get_logger().warn(f'cv_bridge failed: {exc}')
            return
        with self._lock:
            self._latest_bgr = bgr
            self._latest_stamp = time.time()
        if self._publish_preview:
            self._emit_preview(bgr)

    def _emit_preview(self, bgr: np.ndarray):
        try:
            small = cv2.resize(bgr, (320, 180), interpolation=cv2.INTER_AREA)
            ok, buf = cv2.imencode(
                '.jpg', small,
                [int(cv2.IMWRITE_JPEG_QUALITY), self._jpeg_quality])
            if not ok:
                return
            msg = CompressedImage()
            msg.header.stamp = self.get_clock().now().to_msg()
            msg.header.frame_id = 'camera_color_optical_frame'
            msg.format = 'jpeg'
            msg.data = buf.tobytes()
            self._preview_pub.publish(msg)
        except Exception:
            pass

    def _detect_colors(self, bgr, wanted):
        hsv = cv2.cvtColor(bgr, cv2.COLOR_BGR2HSV)
        h, w = hsv.shape[:2]
        area = float(h * w)
        best_name = None
        best_ratio = 0.0
        best_uv = (0, 0)

        for name in wanted:
            key = name.strip().lower()
            ranges = COLOR_HSV.get(key)
            if not ranges:
                continue
            mask = np.zeros((h, w), dtype=np.uint8)
            for lo, hi in ranges:
                mask = cv2.bitwise_or(
                    mask, cv2.inRange(hsv, np.array(lo), np.array(hi)))
            mask = cv2.morphologyEx(
                mask, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))
            ratio = float(cv2.countNonZero(mask)) / area
            if ratio > best_ratio:
                best_ratio = ratio
                best_name = key
                moments = cv2.moments(mask)
                if moments['m00'] > 0:
                    best_uv = (
                        int(moments['m10'] / moments['m00']),
                        int(moments['m01'] / moments['m00']),
                    )
        if best_name is None or best_ratio < self._min_ratio:
            return None, best_ratio, 0, 0
        return best_name, best_ratio, best_uv[0], best_uv[1]

    def _on_find_color(self, request, response):
        colors = [c for c in request.colors if c.strip()]
        if not colors:
            response.found = False
            response.message = 'No colors requested'
            return response

        was_idle = not self._active
        if not self._activate():
            response.found = False
            response.color_name = ''
            response.confidence = 0.0
            response.message = 'Could not start Orbbec color stream'
            return response
        timeout = max(0.5, float(request.timeout_sec) if request.timeout_sec > 0 else 5.0)
        deadline = time.time() + timeout
        found_name = None
        conf = 0.0
        u = v = 0

        try:
            while time.time() < deadline and rclpy.ok():
                frame = None
                with self._lock:
                    if self._latest_bgr is not None:
                        frame = self._latest_bgr.copy()
                if frame is not None:
                    found_name, conf, u, v = self._detect_colors(frame, colors)
                    if found_name is not None:
                        break
                time.sleep(0.05)
        finally:
            if was_idle:
                self._deactivate()

        if found_name is not None:
            response.found = True
            response.color_name = found_name
            response.confidence = float(conf)
            response.u = int(u)
            response.v = int(v)
            response.message = f'Found {found_name} ({conf:.3f})'
            self.get_logger().info(response.message)
        else:
            response.found = False
            response.color_name = ''
            response.confidence = float(conf)
            response.message = (
                f'No match for {colors} within {timeout:.1f}s '
                f'(best_ratio={conf:.4f})')
            self.get_logger().info(response.message)
        return response

    def _publish_status(self):
        msg = String()
        with self._lock:
            age = (time.time() - self._latest_stamp) if self._latest_stamp else -1.0
            active = self._active
        msg.data = json.dumps({
            'active': active,
            'stream_enabled': self._stream_enabled,
            'frame_age_sec': round(age, 2),
            'colors': list(COLOR_HSV.keys()),
        })
        self._status_pub.publish(msg)


def main(args=None):
    rclpy.init(args=args)
    node = VisionGateNode()
    executor = MultiThreadedExecutor(num_threads=2)
    executor.add_node(node)
    try:
        executor.spin()
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
