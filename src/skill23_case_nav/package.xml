<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skill23_case_nav</name>
  <version>1.0.0</version>
  <description>
    Case-based lightweight navigation (no Nav2): pure Python (rclpy) map server,
    localization, front-lidar + US watchdogs, corridor-center A* primitives,
    lidar wake recovery. Bridge on :8082.
  </description>
  <maintainer email="adityaprakash.main@gmail.com">ADEV</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_srvs</depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>studica_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>allterrain</exec_depend>
  <exec_depend>mecanum</exec_depend>
  <exec_depend>xdrive</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
