<?xml version="1.0"?>
<robot name="allterrain_robot">

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.43 0.40 0.15"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.43 0.40 0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- Dual YDLIDAR mounts — same as mecanum (shared lidar_merger ±0.21) -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.12 0 0.045" rpy="0 0 0"/>
  </joint>

  <link name="laser_front"/>
  <joint name="laser_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_front"/>
    <origin xyz="0.21 0 0" rpy="0 0 0"/>
  </joint>

  <link name="laser_back"/>
  <joint name="laser_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_back"/>
    <origin xyz="-0.21 0 0" rpy="0 0 3.141592653589793"/>
  </joint>

</robot>