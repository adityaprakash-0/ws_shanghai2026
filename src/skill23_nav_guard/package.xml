<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skill23_nav_guard</name>
  <version>1.0.0</version>
  <description>Nav2 wheel-level IR/ultrasonic safety guard (pulse lateral nudge)</description>
  <maintainer email="adityaprakash.main@gmail.com">ADEV</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_common</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>studica_control</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>allterrain</exec_depend>
  <exec_depend>mecanum</exec_depend>
  <exec_depend>xdrive</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
