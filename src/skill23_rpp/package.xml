<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skill23_rpp</name>
  <version>1.1.20</version>
  <description>
    skill23 fork of Navigation2 Humble nav2_regulated_pure_pursuit_controller
    (vendored for custom_nav). Plain rclcpp::Node — not lifecycle / not plugin.
    Dual fast/slow rotate-to-heading; feeds Costmap2D from /custom_nav/local_grid.
  </description>
  <maintainer email="adityaprakash.main@gmail.com">ADEV</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>nav2_common</build_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
