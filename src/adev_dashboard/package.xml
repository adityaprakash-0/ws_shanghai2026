<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adev_dashboard</name>
  <version>1.0.0</version>
  <description>Lightweight HTTP bridge and mission manager for ADEV competition dashboard</description>
  <maintainer email="adityaprakash.main@gmail.com">ADEV</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>lifecycle_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>studica_control</exec_depend>
  <exec_depend>skill23_graph_planner</exec_depend>
  <exec_depend>skill23_vision</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
