<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skill23_graph_planner</name>
  <version>1.0.0</version>
  <description>
    Nav2 GraphPlanner plugin: plans only along GeoJSON corridor edges.
    Used by nav2_secret_mode with stock RPP controller.
  </description>
  <maintainer email="adityaprakash.main@gmail.com">ADEV</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <build_depend>nlohmann-json-dev</build_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>studica_control</exec_depend>
  <exec_depend>mecanum</exec_depend>
  <exec_depend>allterrain</exec_depend>
  <exec_depend>xdrive</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/graph_planner_plugin.xml"/>
  </export>
</package>
